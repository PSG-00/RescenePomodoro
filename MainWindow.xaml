<Window x:Class="radiant_noether.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RESCENE Pomodoro Pet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- 테마 동적 브러시 (다크/라이트 모드 적응형) -->
        <SolidColorBrush x:Key="ToolButtonHoverBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="ToolButtonPressedBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="MenuCheckBrush" Color="#FFE04060"/>

        <!-- Windows 11 Fluent 툴바 버튼 스타일 -->
        <Style x:Key="FluentToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 액센트 툴바 버튼 (시작/일시정지 - 고정 너비로 위젯 흔들림 완전 방지) -->
        <Style x:Key="FluentPrimaryToolButton" TargetType="Button" BasedOn="{StaticResource FluentToolButton}">
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="96"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Fluent 모드 탭 버튼 스타일 (표준/원형 위젯 상단 모드 선택용) -->
        <Style x:Key="FluentModeTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 모던 프로그레스 바 스타일 -->
        <Style x:Key="FluentProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#20888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2.5" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Windows 11 Fluent Dark ContextMenu 테마 ================= -->
        <!-- 구분선 (Separator) -->
        <Style x:Key="FluentMenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="#18FFFFFF" Height="1" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 메뉴 아이템 (MenuItem) -->
        <Style x:Key="FluentMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="BgBorder"
                                    Background="Transparent"
                                    CornerRadius="5"
                                    Margin="2,1"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 체크 아이콘 -->
                                    <TextBlock x:Name="CheckIcon"
                                               Text="✓"
                                               Foreground="{DynamicResource MenuCheckBrush}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Visibility="Collapsed"/>

                                    <!-- 텍스트 헤더 -->
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      Margin="2,0,10,0"/>

                                    <!-- 서브메뉴 화살표 -->
                                    <TextBlock x:Name="Arrow"
                                               Grid.Column="2"
                                               Text="›"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#888888"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- 서브메뉴 팝업 (테마 연동 스타일 적용) -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PopupAnimation="Fade">
                                <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4,4"
                                        Margin="0,0,8,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.25"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#22888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 루트 컨텍스트 메뉴 스타일 -->
        <Style x:Key="FluentContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#F2242424"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="14,10" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <!-- 메인 캐릭터 컨테이너: 상단 캐릭터 + 하단 Fluent 타이머 도크 -->
        <StackPanel x:Name="CharacterContainer"
                    HorizontalAlignment="Center"
                    MouseEnter="CharacterContainer_MouseEnter"
                    MouseLeave="CharacterContainer_MouseLeave"
                    MouseLeftButtonDown="CharacterContainer_MouseLeftButtonDown">

            <!-- 캐릭터 이미지 -->
            <Image x:Name="CharacterImage"
                   Width="240"
                   Height="240"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"
                   RenderOptions.BitmapScalingMode="Fant"
                   RenderOptions.EdgeMode="Aliased">
                <Image.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.35"/>
                </Image.Effect>
            </Image>

            <!-- 하단 Windows 11 Fluent 플로팅 도크 (3가지 타이머 위젯 스타일 지원) -->
            <Border x:Name="TimerOverlay"
                    HorizontalAlignment="Center"
                    MinWidth="285"
                    Margin="0,6,0,0"
                    Background="#F01E1E1E"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="12,9"
                    Opacity="0"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect x:Name="DockShadow" Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.32"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- ================= 1. 간소화 버전 (Compact) ================= -->
                    <StackPanel x:Name="DockCompact" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 상단: [모드 상태 | 타이머 | 세션 | 멤버] 시인성 강화 통합 캡슐 블럭 -->
                        <Border x:Name="TimerHeaderCapsule"
                                Background="#18FFFFFF"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,5"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Fluent InfoBadge (알약 모양 상태 태그) -->
                                <Border x:Name="ModeBadge"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Background="#33E04060"
                                        BorderBrush="#66E04060"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="BadgeDot" Width="6" Height="6" Fill="#FFE04060" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtMode"
                                                   Text="집중"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 세련된 타이머 텍스트 -->
                                <TextBlock x:Name="TxtTimer"
                                           Text="25:00"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, Malgun Gothic"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>

                                <!-- 세션 정보 배지 [1/4] -->
                                <Border x:Name="SessionBadgeCompact" Background="#1AFFFFFF" CornerRadius="6" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSessionCompact"
                                               Text="1/4"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#D0D0D0"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- 멤버 이름 태그 배지 -->
                                <Border x:Name="MemberBadge" Background="#1AFFFFFF" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtMember"
                                               Text="원이"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 미세 구분선 -->
                        <Border x:Name="DockDivider" Height="1" Background="#15FFFFFF" Margin="0,2,0,5"/>

                        <!-- 하단 Fluent 툴바 버튼 그룹 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnPlayPause"
                                    Content="▶ 시작"
                                    Style="{StaticResource FluentPrimaryToolButton}"
                                    Click="BtnPlayPause_Click"/>
                            <Button x:Name="BtnSkip"
                                    Content="⏭ 건너뛰기"
                                    Padding="8,4"
                                    Style="{StaticResource FluentToolButton}"
                                    Click="BtnSkip_Click"/>
                            <Button x:Name="BtnReset"
                                    Content="↺"
                                    Width="32"
                                    Height="26"
                                    Padding="0"
                                    FontSize="13"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    ToolTip="타이머 초기화"
                                    Style="{StaticResource FluentToolButton}"
                                    Click="BtnReset_Click"/>
                            <Button x:Name="BtnSettings"
                                    Content="⚙"
                                    Width="34"
                                    Height="26"
                                    Padding="0"
                                    FontSize="13"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Margin="2,0,0,0"
                                    ToolTip="설정"
                                    Style="{StaticResource FluentToolButton}"
                                    Click="BtnSettings_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ================= 2. 표준 버전 (Standard) ================= -->
                    <StackPanel x:Name="DockStandard" Visibility="Collapsed" Width="290" HorizontalAlignment="Center">
                        <!-- 상단 모드 선택 캡슐 탭 (집중 / 짧은 휴식 / 긴 휴식) -->
                        <Border x:Name="StdModeCapsule"
                                Background="#12FFFFFF"
                                BorderBrush="#1CFFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="3"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnStdFocus"
                                        Content="집중"
                                        Style="{StaticResource FluentModeTab}"
                                        Click="BtnStdFocus_Click"/>
                                <Button x:Name="BtnStdBreak"
                                        Content="짧은 휴식"
                                        Style="{StaticResource FluentModeTab}"
                                        Click="BtnStdBreak_Click"/>
                                <Button x:Name="BtnStdLongBreak"
                                        Content="긴 휴식"
                                        Style="{StaticResource FluentModeTab}"
                                        Click="BtnStdLongBreak_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 대형 타이머 텍스트 -->
                        <TextBlock x:Name="TxtTimerStd"
                                   Text="25:00"
                                   FontSize="35"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Malgun Gothic"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,2"/>

                        <!-- 세션 및 멤버 배지 행 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Border x:Name="SessionBadgeStd" Background="#18FFFFFF" CornerRadius="6" Padding="7,2" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtSessionStd"
                                           Text="Session 1/4"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#D5D5D5"/>
                            </Border>
                            <Border x:Name="MemberBadgeStd" Background="#18FFFFFF" CornerRadius="6" Padding="7,2">
                                <TextBlock x:Name="TxtMemberStd"
                                           Text="원이"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#D5D5D5"/>
                            </Border>
                        </StackPanel>

                        <!-- 세션 진행 상태 프로그레스 바 -->
                        <ProgressBar x:Name="ProgressStd"
                                     Style="{StaticResource FluentProgressBar}"
                                     Height="5"
                                     Margin="6,2,6,8"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"/>

                        <!-- 미세 구분선 -->
                        <Border x:Name="DockDividerStd" Height="1" Background="#15FFFFFF" Margin="0,0,0,7"/>

                        <!-- 컨트롤 버튼 그룹 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnPlayPauseStd"
                                    Content="▶ 시작"
                                    Style="{StaticResource FluentPrimaryToolButton}"
                                    Click="BtnPlayPause_Click"/>
                            <Button x:Name="BtnSkipStd"
                                    Content="⏭ 건너뛰기"
                                    Padding="8,4"
                                    Style="{StaticResource FluentToolButton}"
                                    Click="BtnSkip_Click"/>
                            <Button x:Name="BtnResetStd"
                                    Content="↺"
                                    Width="32"
                                    Height="26"
                                    Padding="0"
                                    FontSize="13"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    ToolTip="타이머 초기화"
                                    Style="{StaticResource FluentToolButton}"
                                    Click="BtnReset_Click"/>
                            <Button x:Name="BtnSettingsStd"
                                    Content="⚙"
                                    Width="34"
                                    Height="26"
                                    Padding="0"
                                    FontSize="13"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Margin="2,0,0,0"
                                    ToolTip="설정"
                                    Style="{StaticResource FluentToolButton}"
                                    Click="BtnSettings_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ================= 3. 원형 링 & 통계 버전 (Ring & Stats) ================= -->
                    <StackPanel x:Name="DockRing" Visibility="Collapsed" Width="290" HorizontalAlignment="Center">
                        <!-- 상단 모드 선택 캡슐 탭 -->
                        <Border x:Name="RingModeCapsule"
                                Background="#12FFFFFF"
                                BorderBrush="#1CFFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="3"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnRingFocus"
                                        Content="집중"
                                        Style="{StaticResource FluentModeTab}"
                                        Click="BtnStdFocus_Click"/>
                                <Button x:Name="BtnRingBreak"
                                        Content="짧은 휴식"
                                        Style="{StaticResource FluentModeTab}"
                                        Click="BtnStdBreak_Click"/>
                                <Button x:Name="BtnRingLongBreak"
                                        Content="긴 휴식"
                                        Style="{StaticResource FluentModeTab}"
                                        Click="BtnStdLongBreak_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 시계형 원형 프로그레스 링 영역 (160x160) -->
                        <Grid Width="160" Height="160" HorizontalAlignment="Center" Margin="0,4,0,4">
                            <!-- 배경 트랙 원 -->
                            <Ellipse x:Name="RingTrack"
                                     Width="136"
                                     Height="136"
                                     Stroke="#20888888"
                                     StrokeThickness="7"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                            <!-- 동적 경과 호 (Arc) -->
                            <Path x:Name="ArcRingProgress"
                                  Width="160"
                                  Height="160"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Stretch="None"
                                  Stroke="#FFE04060"
                                  StrokeThickness="7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>

                            <!-- 링 내부 중앙 정보 (모드 라벨, 대형 카운트다운, 진행률 %) -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtRingMode"
                                           Text="집중"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FFE04060"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,1"/>
                                <TextBlock x:Name="TxtTimerRing"
                                           Text="25:00"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, Malgun Gothic"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtRingPercent"
                                           Text="0%"
                                           FontSize="11"
                                           Foreground="#999999"
                                           HorizontalAlignment="Center"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 4개 세션 진행 도트 및 세션 표시 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse x:Name="RingDot1" Width="7" Height="7" Fill="#FFE04060" Margin="2.5,0"/>
                            <Ellipse x:Name="RingDot2" Width="7" Height="7" Fill="#28FFFFFF" Margin="2.5,0"/>
                            <Ellipse x:Name="RingDot3" Width="7" Height="7" Fill="#28FFFFFF" Margin="2.5,0"/>
                            <Ellipse x:Name="RingDot4" Width="7" Height="7" Fill="#28FFFFFF" Margin="2.5,0"/>
                            <TextBlock x:Name="TxtRingSession"
                                       Text="세션 1 / 4"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#BBBBBB"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 컨트롤 버튼 그룹 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Button x:Name="BtnPlayPauseRing"
                                    Content="▶ 시작"
                                    Style="{StaticResource FluentPrimaryToolButton}"
                                    Width="92"
                                    Click="BtnPlayPause_Click"/>
                            <Button x:Name="BtnSkipRing"
                                    Content="⏭ 건너뛰기"
                                    Padding="7,4"
                                    Style="{StaticResource FluentToolButton}"
                                    Click="BtnSkip_Click"/>
                            <Button x:Name="BtnResetRing"
                                    Content="↺"
                                    Width="30"
                                    Height="26"
                                    Padding="0"
                                    FontSize="13"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    ToolTip="타이머 초기화"
                                    Style="{StaticResource FluentToolButton}"
                                    Click="BtnReset_Click"/>
                            <Button x:Name="BtnSettingsRing"
                                    Content="⚙"
                                    Width="32"
                                    Height="26"
                                    Padding="0"
                                    FontSize="13"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Margin="2,0,0,0"
                                    ToolTip="설정"
                                    Style="{StaticResource FluentToolButton}"
                                    Click="BtnSettings_Click"/>
                        </StackPanel>

                        <!-- 구분선 -->
                        <Border x:Name="RingDivider" Height="1" Background="#15FFFFFF" Margin="0,2,0,6"/>

                        <!-- 오늘 / 총 세션 통계 카드 -->
                        <Border x:Name="RingStatsCard"
                                Background="#14FFFFFF"
                                BorderBrush="#1CFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,6"
                                Margin="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 오늘 완료 -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtStatTodayVal" Text="0" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtStatTodayLbl" Text="오늘 완료" FontSize="9.5" Foreground="#909090" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- 누적 완료 -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtStatTotalVal" Text="0" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtStatTotalLbl" Text="누적 완료" FontSize="9.5" Foreground="#909090" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- 오늘 집중 시간 -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtStatTimeVal" Text="0분" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtStatTimeLbl" Text="집중 시간" FontSize="9.5" Foreground="#909090" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
