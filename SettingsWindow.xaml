<Window x:Class="radiant_noether.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="SettingsRootWindow"
        Title="설정 - RESCENE 뽀모도로"
        Height="740" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="#202020"
        Foreground="#EEEEEE"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        Closing="SettingsWindow_Closing">

    <Window.Resources>
        <!-- 기본 색상 팔레트 (다크/라이트 모드 적응형 동적 브러시) -->
        <SolidColorBrush x:Key="CardBackground" Color="#262629"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#98989F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E04060"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#EB5573"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#CC3555"/>
        <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#22888888"/>
        <SolidColorBrush x:Key="ToggleBorderOffBrush" Color="#33888888"/>
        <SolidColorBrush x:Key="ToggleThumbOffBrush" Color="#D0D0D0"/>

        <!-- 섹션 헤더 스타일 -->
        <Style x:Key="FluentSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="4,16,0,8"/>
        </Style>

        <!-- Windows 11 / iOS 스타일 SettingsCard 기본 스타일 -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Windows 11 / iOS 스타일 ToggleSwitch (CheckBox 기반) -->
        <Style x:Key="FluentToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="40" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border x:Name="Track"
                                        Background="{DynamicResource ToggleTrackOffBrush}"
                                        BorderBrush="{DynamicResource ToggleBorderOffBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"/>
                                <Ellipse x:Name="Thumb"
                                         Width="12" Height="12"
                                         Fill="{DynamicResource ToggleThumbOffBrush}"
                                         HorizontalAlignment="Left"
                                         Margin="4,0,0,0"
                                         VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter x:Name="ContentPresenter"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 버튼 스타일 -->
        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 액센트 버튼 스타일 (저장 등 주요 액션) -->
        <Style x:Key="FluentAccentButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 모던 인라인 수치 배지 / NumberBox 스타일 -->
        <Style x:Key="ValueBadge" TargetType="Border">
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinWidth" Value="56"/>
        </Style>

        <!-- 세그먼트 라디오 카드 스타일 (테마 / 언어 선택 - 절대 고정 크기 150x36) -->
        <Style x:Key="FluentSegmentCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder"
                                Width="150"
                                Height="36"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 타이머 스타일 균등 3분할 카드 스타일 -->
        <Style x:Key="FluentStyleCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder"
                                Height="36"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 멤버 선택 타일 스타일 -->
        <Style x:Key="FluentRadioCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder"
                                Height="36"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 바 -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Padding="24,18,24,14" Background="#1C1C1C" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtHeaderTitle"
                               Text="RESCENE 타이머 설정"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtHeaderSubtitle"
                           Text="바탕화면 뽀모도로 위젯의 멤버, 시간 및 표시 옵션을 설정합니다."
                           FontSize="12"
                           Foreground="{StaticResource SubtleTextBrush}"
                           Margin="28,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- 스크롤 본문 (SettingsCards 리스트) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,10,22,10">
            <StackPanel>

                <!-- 0. 테마 설정 섹션 -->
                <TextBlock x:Name="LblSectionTheme" Text="테마 디자인" Style="{StaticResource FluentSectionTitle}"/>
                <Border x:Name="CardTheme" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock x:Name="LblThemeDesc" Text="위젯과 설정창의 컬러 테마(화이트/블랙)를 선택합니다." FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadioThemeDark"
                                         Content="🌙 다크 모드 (블랙)"
                                         Style="{StaticResource FluentSegmentCard}"
                                         GroupName="AppTheme"
                                         Margin="0,0,8,0"
                                         Checked="RadioTheme_Checked"/>
                            <RadioButton x:Name="RadioThemeLight"
                                         Content="☀️ 라이트 모드 (화이트)"
                                         Style="{StaticResource FluentSegmentCard}"
                                         GroupName="AppTheme"
                                         Margin="0,0,0,0"
                                         Checked="RadioTheme_Checked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 1. 언어 설정 섹션 -->
                <TextBlock x:Name="LblSectionLanguage" Text="언어 / Language" Style="{StaticResource FluentSectionTitle}"/>
                <Border x:Name="CardLanguage" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock x:Name="LblLanguageDesc" Text="프로그램 전체에 적용할 표시 언어를 선택하세요." FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadioLangKo"
                                         Content="Korean(한국어)"
                                         Style="{StaticResource FluentSegmentCard}"
                                         GroupName="AppLanguage"
                                         Margin="0,0,8,0"
                                         Checked="RadioLang_Checked"/>
                            <RadioButton x:Name="RadioLangEn"
                                         Content="English(영어)"
                                         Style="{StaticResource FluentSegmentCard}"
                                         GroupName="AppLanguage"
                                         Margin="0,0,0,0"
                                         Checked="RadioLang_Checked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 1-2. 타이머 위젯 스타일 섹션 -->
                <TextBlock x:Name="LblSectionTimerStyle" Text="타이머 위젯 스타일" Style="{StaticResource FluentSectionTitle}"/>
                <Border x:Name="CardTimerStyle" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock x:Name="LblTimerStyleDesc" Text="위젯의 크기와 타이머 정보 표시 방식을 선택합니다." FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RadioStyleCompact"
                                         Grid.Column="0"
                                         Content="간소화"
                                         Style="{StaticResource FluentStyleCard}"
                                         GroupName="AppTimerStyle"
                                         Checked="RadioStyle_Checked"/>
                            <RadioButton x:Name="RadioStyleStandard"
                                         Grid.Column="2"
                                         Content="표준"
                                         Style="{StaticResource FluentStyleCard}"
                                         GroupName="AppTimerStyle"
                                         Checked="RadioStyle_Checked"/>
                            <RadioButton x:Name="RadioStyleRing"
                                         Grid.Column="4"
                                         Content="원형 링 &amp; 통계"
                                         Style="{StaticResource FluentStyleCard}"
                                         GroupName="AppTimerStyle"
                                         Checked="RadioStyle_Checked"/>
                        </Grid>
                        <TextBlock x:Name="LblTimerStyleDetail" Text="가볍게 볼 수 있는 심플 도크 (세션 번호 포함)" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="2,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2. 멤버 선택 섹션 -->
                <TextBlock x:Name="LblSectionMember" Text="대표 멤버" Style="{StaticResource FluentSectionTitle}"/>
                <Border x:Name="CardMember" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock x:Name="LblMemberDesc" Text="위젯에 표시할 리센느 멤버를 선택하세요." FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,10"/>
                        <WrapPanel x:Name="PanelMembers" Orientation="Horizontal"/>
                    </StackPanel>
                </Border>

                <!-- 3. 시간 설정 섹션 -->
                <TextBlock x:Name="LblSectionTimer" Text="시간 및 타이머" Style="{StaticResource FluentSectionTitle}"/>

                <!-- 집중 시간 카드 -->
                <Border x:Name="CardFocus" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="LblCardFocusTitle" Text="집중 시간" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="LblCardFocusDesc" Text="학습 또는 업무에 몰입하는 시간" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SliderFocus" Width="110" Minimum="1" Maximum="120" Value="25"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    ValueChanged="SliderFocus_ValueChanged"/>
                            <Border x:Name="BadgeFocus" Style="{StaticResource ValueBadge}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBox x:Name="TxtFocusInput" Text="25" Width="28"
                                             Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                             CaretBrush="#FFFFFF" SelectionBrush="#E04060"
                                             TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                             VerticalAlignment="Center" MaxLength="3"
                                             FocusVisualStyle="{x:Null}"
                                             PreviewTextInput="NumberValidationTextBox"
                                             LostFocus="TxtFocusInput_LostFocus"
                                             KeyDown="TxtInput_KeyDown"/>
                                    <TextBlock x:Name="LblFocusUnit" Text="분" FontSize="11" Foreground="#A0A0A0" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 짧은 휴식 카드 -->
                <Border x:Name="CardBreak" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="LblCardBreakTitle" Text="짧은 휴식" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="LblCardBreakDesc" Text="집중 사이클 직후 주어지는 휴식 시간" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SliderBreak" Width="110" Minimum="1" Maximum="60" Value="5"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    ValueChanged="SliderBreak_ValueChanged"/>
                            <Border x:Name="BadgeBreak" Style="{StaticResource ValueBadge}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBox x:Name="TxtBreakInput" Text="5" Width="28"
                                             Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                             CaretBrush="#FFFFFF" SelectionBrush="#E04060"
                                             TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                             VerticalAlignment="Center" MaxLength="3"
                                             FocusVisualStyle="{x:Null}"
                                             PreviewTextInput="NumberValidationTextBox"
                                             LostFocus="TxtBreakInput_LostFocus"
                                             KeyDown="TxtInput_KeyDown"/>
                                    <TextBlock x:Name="LblBreakUnit" Text="분" FontSize="11" Foreground="#A0A0A0" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 긴 휴식 카드 -->
                <Border x:Name="CardLongBreak" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="LblCardLongBreakTitle" Text="긴 휴식" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="LblCardLongBreakDesc" Text="4회 집중 완료 후 주어지는 긴 휴식 시간" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SliderLongBreak" Width="110" Minimum="1" Maximum="60" Value="15"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    ValueChanged="SliderLongBreak_ValueChanged"/>
                            <Border x:Name="BadgeLongBreak" Style="{StaticResource ValueBadge}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBox x:Name="TxtLongBreakInput" Text="15" Width="28"
                                             Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                             CaretBrush="#FFFFFF" SelectionBrush="#E04060"
                                             TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                             VerticalAlignment="Center" MaxLength="3"
                                             FocusVisualStyle="{x:Null}"
                                             PreviewTextInput="NumberValidationTextBox"
                                             LostFocus="TxtLongBreakInput_LostFocus"
                                             KeyDown="TxtInput_KeyDown"/>
                                    <TextBlock x:Name="LblLongBreakUnit" Text="분" FontSize="11" Foreground="#A0A0A0" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. 위젯 외형 설정 섹션 -->
                <TextBlock x:Name="LblSectionAppearance" Text="위젯 디자인 및 표시" Style="{StaticResource FluentSectionTitle}"/>

                <!-- 캐릭터 크기 카드 -->
                <Border x:Name="CardSize" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="LblCardSizeTitle" Text="캐릭터 크기" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="LblCardSizeDesc" Text="화면에 표시되는 위젯의 너비/높이" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SliderSize" Width="110" Minimum="120" Maximum="360" Value="240"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    ValueChanged="SliderSize_ValueChanged"/>
                            <Border x:Name="BadgeSize" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="TxtSizeVal" Text="240px" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 위젯 투명도 카드 -->
                <Border x:Name="CardOpacity" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="LblCardOpacityTitle" Text="불투명도" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="LblCardOpacityDesc" Text="위젯의 투명도 수준" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SliderOpacity" Width="110" Minimum="0.2" Maximum="1.0" Value="1.0"
                                    SmallChange="0.05" VerticalAlignment="Center" Margin="0,0,8,0"
                                    ValueChanged="SliderOpacity_ValueChanged"/>
                            <Border x:Name="BadgeOpacity" Style="{StaticResource ValueBadge}">
                                <TextBlock x:Name="TxtOpacityVal" Text="100%" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 항상 맨 위에 표시 카드 -->
                <Border x:Name="CardAlwaysOnTop" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="LblCardAlwaysOnTopTitle" Text="항상 맨 위에 표시" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="LblCardAlwaysOnTopDesc" Text="다른 모든 창보다 위에 상주합니다 (Always on Top)" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkAlwaysOnTop" Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" VerticalAlignment="Center" Click="ChkOption_Click"/>
                    </Grid>
                </Border>

                <!-- 시간 항상 표시 카드 -->
                <Border x:Name="CardAlwaysShowTime" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="LblCardAlwaysShowTimeTitle" Text="타이머 시간 항상 표시" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="LblCardAlwaysShowTimeDesc" Text="끄면 마우스를 올렸을 때만 도크가 표시됩니다" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkAlwaysShowTime" Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" VerticalAlignment="Center" Click="ChkOption_Click"/>
                    </Grid>
                </Border>

                <!-- 음성 및 소리 알림 카드 -->
                <Border x:Name="CardSound" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="LblCardSoundTitle" Text="멤버 음성 / 알림음 재생" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="LblCardSoundDesc" Text="집중 ↔ 휴식 전환 시 음성 또는 알림 소리 재생" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkPlaySound" Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" VerticalAlignment="Center" Click="ChkOption_Click"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 하단 액션 CommandBar -->
        <Border x:Name="FooterBorder" Grid.Row="2" Background="#1C1C1C" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnImages"
                        Grid.Column="0"
                        Content="📁 이미지 폴더"
                        Style="{StaticResource FluentButton}"
                        Margin="0,0,6,0"
                        Click="BtnOpenImages_Click"
                        ToolTip="멤버별 캐릭터 이미지(.png)를 관리합니다."/>

                <Button x:Name="BtnSounds"
                        Grid.Column="1"
                        Content="🎵 음성 폴더"
                        Style="{StaticResource FluentButton}"
                        Margin="0,0,6,0"
                        Click="BtnOpenSounds_Click"
                        ToolTip="멤버별 음성 파일(.mp3, .wav)을 관리합니다."/>

                <Button x:Name="BtnSave"
                        Grid.Column="3"
                        Content="저장 및 적용"
                        Style="{StaticResource FluentAccentButton}"
                        Padding="22,7"
                        Click="BtnSave_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
